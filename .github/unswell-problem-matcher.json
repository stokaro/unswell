{
  "problemMatcher": [
    {
      "owner": "unswell",
      "pattern": [
        {
          "regexp": "^(.+):([0-9]+):([0-9]+): (error|warning) \\[([^]]+)\\] (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    },
    {
      "owner": "unswell-note",
      "severity": "notice",
      "pattern": [
        {
          "regexp": "^(.+):([0-9]+):([0-9]+): note \\[([^]]+)\\] (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
