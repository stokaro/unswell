---
// The opening picture of the research report.
//
// A painted workbench: measuring instruments stand on it, pages hang above it,
// one page lies under a lamp, and a basket of crumpled paper stands below. It
// shows the way the work was done and nothing of how it ended.
//
// The build makes the sizes a page needs from one file. The picture has a
// paper ground of its own, so it reads the same in both themes.
import { Image } from 'astro:assets';

import picture from '../assets/report-hero.jpg';

const label =
	'A painted workbench with a balance scale, gauges, a tuning fork, and dividers. A row of pages hangs above it, one page lies under a lamp, and a basket of crumpled paper stands below.';
---

<figure class="u-hero">
	<Image src={picture} alt={label} widths={[720, 1080, 1536]} sizes="(min-width: 50rem) 45rem, 100vw" quality={82} loading="eager" />
</figure>
