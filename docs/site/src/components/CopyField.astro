---
// A command a reader is meant to run, with a copy button.
//
// The `$` is rendered separately and is not copied: a prompt pasted into a
// shell is a command that fails.
interface Props {
	command: string;
}

const { command } = Astro.props;
---

<div class="u-copy">
	<span class="u-copy__text"><span class="u-t-prompt" aria-hidden="true">$</span> {command}</span>
	<button class="u-copy__button" type="button" data-copy={command}>Copy</button>
</div>

<script>
	for (const button of document.querySelectorAll('button[data-copy]')) {
		button.addEventListener('click', async () => {
			const command = button.getAttribute('data-copy');
			if (!command) return;
			const previous = button.textContent;
			try {
				await navigator.clipboard.writeText(command);
				button.textContent = 'Copied';
			} catch {
				// A browser that refuses the clipboard leaves the text selectable,
				// which is the fallback a reader already knows.
				button.textContent = 'Select it';
			}
			window.setTimeout(() => {
				button.textContent = previous;
			}, 1600);
		});
	}
</script>
