{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unswell:tetra-import:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository", "revision", "license", "include_xml", "files"],
  "properties": {
    "version": {"const": "unswell-tetra-import-v1"},
    "repository": {"const": "https://github.com/chemicaltree/tetra"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"const": "CC-BY-4.0"},
    "include_xml": {"type": "boolean"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "git_blob", "xml_base64"],
        "properties": {
          "path": {"type": "string", "pattern": "^original/[PW][0-9]{2}-[0-9]{4}-[ABC]\\.xml$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "xml_base64": {"type": "string", "maxLength": 349528}
        }
      }
    }
  }
}
