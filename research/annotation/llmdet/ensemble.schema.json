{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "feature_count",
    "classes",
    "trees"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "unswell-llmdet-ensemble-v1"
    },
    "feature_count": {
      "type": "integer"
    },
    "classes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "trees": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "class",
          "comparison",
          "splits",
          "leaves"
        ],
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "integer"
          },
          "comparison": {
            "const": "numeric-le"
          },
          "splits": {
            "type": "array",
            "maxItems": 1023,
            "items": {
              "type": "object",
              "required": [
                "feature",
                "threshold",
                "left",
                "right"
              ],
              "additionalProperties": false,
              "properties": {
                "feature": {
                  "type": "integer"
                },
                "threshold": {
                  "type": "number"
                },
                "left": {
                  "type": "integer"
                },
                "right": {
                  "type": "integer"
                }
              }
            }
          },
          "leaves": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
