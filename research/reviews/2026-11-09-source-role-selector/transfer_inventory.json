  "targets": [
    {
      "repo": "nats-io/nats-server",
      "source_sha256": "af1a7d8d9cc9314ac8ccaa5b851b148de1ca0a781e48a63b7204921abce0b3e6",
      "start": 1707,
      "end": 1771,
      "quote": "If you are interested in contributing to NATS, read about our..."
    },
    {
      "repo": "nats-io/nats-server",
      "source_sha256": "af1a7d8d9cc9314ac8ccaa5b851b148de1ca0a781e48a63b7204921abce0b3e6",
      "start": 3815,
      "end": 3924,
      "quote": "Who uses NATS? See our [list of users](https://nats.io/#who-uses-nats) on [https://nats.io](https://nats.io)."
    },
    {
      "repo": "denoland/deno",
      "source_sha256": "83a959d62dea940f94ce1b50024928e34afb447de35197b7ea1d944fd6dbbcf7",
      "start": 2950,
      "end": 3005,
      "quote": "We appreciate your help! To contribute, please read our"
    },
    {
      "repo": "syncthing/syncthing",
      "source_sha256": "42b3725bed4bbefe15dc3284f3246333a721818722752fe69f61478b3b8eba15",
      "start": 533,
      "end": 607,
      "quote": "files between two or more computers. We strive to fulfill the goals below."
    },
    {
      "repo": "syncthing/syncthing",
      "source_sha256": "42b3725bed4bbefe15dc3284f3246333a721818722752fe69f61478b3b8eba15",
      "start": 838,
      "end": 906,
      "quote": "   Protecting the user's data is paramount. We take every reasonable"
    },
    {
      "repo": "syncthing/syncthing",
      "source_sha256": "42b3725bed4bbefe15dc3284f3246333a721818722752fe69f61478b3b8eba15",
      "start": 993,
      "end": 1067,
      "quote": "   Again, protecting the user's data is paramount. Regardless of our other"
    },
    {
      "repo": "syncthing/syncthing",
      "source_sha256": "42b3725bed4bbefe15dc3284f3246333a721818722752fe69f61478b3b8eba15",
      "start": 1068,
      "end": 1134,
      "quote": "   goals, we must never allow the user's data to be susceptible to"
    },
    {
      "repo": "syncthing/syncthing",
      "source_sha256": "42b3725bed4bbefe15dc3284f3246333a721818722752fe69f61478b3b8eba15",
      "start": 1403,
      "end": 1476,
      "quote": "   Syncthing should run on every common computer. We are mindful that the"
    },
    {
      "repo": "syncthing/syncthing",
      "source_sha256": "42b3725bed4bbefe15dc3284f3246333a721818722752fe69f61478b3b8eba15",
      "start": 1716,
      "end": 1792,
      "quote": "   There are many things we care about that don't make it on to the list. It"
    },
    {
      "repo": "astral-sh/ruff",
      "source_sha256": "f25c5e6b098aadfed8313b8c8d2860fe88694114cf42ea7f243235cd28eeb313",
      "start": 6760,
      "end": 6844,
      "quote": "Starting with version `0.5.0`, Ruff can be installed with our standalone installers:"
    },
    {
      "repo": "astral-sh/ruff",
      "source_sha256": "f25c5e6b098aadfed8313b8c8d2860fe88694114cf42ea7f243235cd28eeb313",
      "start": 17639,
      "end": 17715,
      "quote": "We're grateful to the maintainers of these tools for their work, and for all"
    },
    {
      "repo": "duckdb/duckdb",
      "source_sha256": "d9c2afdbd78821e5cd28731bdefa22760374c7670ef2100cd4c44e2d8ced8a8a",
      "start": 4626,
      "end": 4748,
      "quote": "If you want to install DuckDB, please see [our installation page](https://duckdb.org/docs/installation/) for instructions."
    },
    {
      "repo": "duckdb/duckdb",
      "source_sha256": "d9c2afdbd78821e5cd28731bdefa22760374c7670ef2100cd4c44e2d8ced8a8a",
      "start": 5522,
      "end": 5658,
      "quote": "Please also refer to our [Build Guide](https://duckdb.org/docs/current/dev/building/overview) and [Contribution Guide](CONTRIBUTING.md)."
    },
    {
      "repo": "qdrant/qdrant",
      "source_sha256": "f1455d12252bf40235ad0128d8e98b2cd6d42583e441ac832b01f4daf08df2e4",
      "start": 3456,
      "end": 3545,
      "quote": "Now you can connect to the server with any [client](#clients). For example, using Python:"
    },
    {
      "repo": "qdrant/qdrant",
      "source_sha256": "f1455d12252bf40235ad0128d8e98b2cd6d42583e441ac832b01f4daf08df2e4",
      "start": 3653,
      "end": 3843,
      "quote": "Before deploying Qdrant to production, be sure to read our [installation](https://qdrant.tech/documentation/installation/) and [security](https://qdrant.tech/documentation/security/) guides."
    },
    {
      "repo": "qdrant/qdrant",
      "source_sha256": "f1455d12252bf40235ad0128d8e98b2cd6d42583e441ac832b01f4daf08df2e4",
      "start": 6370,
      "end": 6705,
      "quote": "There's more to discovery than text search, especially when it comes to food. People often choose meals based on appearance rather than descriptions and ingredients. Let Qdrant help your users find their next delicious meal using visual search, even if they don't know the dish's name. [Check it out!](https://qdrant.to/food-discovery)"
    },
    {
      "repo": "qdrant/qdrant",
      "source_sha256": "f1455d12252bf40235ad0128d8e98b2cd6d42583e441ac832b01f4daf08df2e4",
      "start": 10648,
      "end": 10782,
      "quote": "We are happy to receive your contributions! Before opening a pull request, please read our [Contributing Guide](docs/CONTRIBUTING.md)."
    },
    {
      "repo": "grafana/loki",
      "source_sha256": "73942e81674d91e98502b7d1da7d0958176777677c24ea9f3636892c2374d539",
      "start": 2299,
      "end": 2471,
      "quote": "Loki is like Prometheus, but for logs: we prefer a multidimensional label-based approach to indexing, and want a single-binary, easy to operate system with no dependencies."
    },
    {
      "repo": "grafana/loki",
      "source_sha256": "73942e81674d91e98502b7d1da7d0958176777677c24ea9f3636892c2374d539",
      "start": 7551,
      "end": 7714,
      "quote": "You need an up-to-date version of [Go](https://go.dev/), we recommend using the version found in our [Makefile](https://github.com/grafana/loki/blob/main/Makefile)"
    }
  ]
}
